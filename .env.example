# Skopiuj do pliku .env (jest w .gitignore) i zmień, co potrzebujesz.
# Ścieżki mogą zaczynać się od ~.

# Folder z plikami "O mnie.md" i "Projekty.md" (domyślnie ./profil)
# CV_APP_NOTES_DIR=~/Projects/cv-design-automate/profil

# Folder, do którego trafiają gotowe CV
# CV_APP_CV_OUTPUT_DIR=~/CV

# Nadawcy maili z ofertami (lista w JSON)
# CV_APP_SENDERS=["jobalert@wysylka.pracuj.pl"]

# Plik credentials.json z Google Cloud (typ "Desktop app"); domyślnie ~/.config/cv-app/credentials.json
# CV_APP_GMAIL_CREDENTIALS_PATH=~/.config/cv-app/credentials.json

# Token OAuth zapisywany po pierwszym logowaniu; domyślnie ~/.local/share/cv-app/token.json
# CV_APP_GMAIL_TOKEN_PATH=~/.local/share/cv-app/token.json

# Katalog na bazę SQLite i cache; domyślnie ~/.local/share/cv-app
# CV_APP_DATA_DIR=~/.local/share/cv-app

# Port panelu (panel zawsze nasłuchuje tylko na 127.0.0.1)
# CV_APP_PORT=8765
