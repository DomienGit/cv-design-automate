# Skopiuj do pliku .env (jest w .gitignore) i zmień, co potrzebujesz.
# Ścieżki mogą zaczynać się od ~.

# Folder z plikami "O mnie.md" i "Projekty.md" (domyślnie ./profil)
# CV_APP_NOTES_DIR=~/Projects/cv-design-automate/profil

# Biblioteka gotowych CV: podfoldery per stanowisko (cv/DevOps/, cv/Helpdesk/ ...)
# z PDF i najlepiej źródłem .json/.md obok; skrypt szuka tu CV pasującego do oferty
# CV_APP_CV_LIBRARY_DIR=~/Projects/cv-design-automate/cv
# Progi pokrycia technologii oferty (%): CV bez zmian / edycja; niżej nowe CV
# CV_APP_CV_MATCH_USE_THRESHOLD=80
# CV_APP_CV_MATCH_EDIT_THRESHOLD=50
# Ile najlepszych CV dostaje AI do decyzji
# CV_APP_CV_MATCH_CANDIDATES=3

# Folder, do którego trafiają gotowe CV
# CV_APP_CV_OUTPUT_DIR=~/CV

# Nadawcy maili z ofertami (lista w JSON); domyślnie wszystkie obsługiwane portale
# CV_APP_SENDERS=["jobalert@wysylka.pracuj.pl","no-reply@justjoin.it","notifications@nofluffjobs.com","jobalert@mailing.theprotocol.it"]

# Plik credentials.json z Google Cloud (typ "Desktop app"); domyślnie ~/.config/cv-app/credentials.json
# CV_APP_GMAIL_CREDENTIALS_PATH=~/.config/cv-app/credentials.json

# Token OAuth zapisywany po pierwszym logowaniu; domyślnie ~/.local/share/cv-app/token.json
# CV_APP_GMAIL_TOKEN_PATH=~/.local/share/cv-app/token.json

# Katalog na bazę SQLite i cache; domyślnie ~/.local/share/cv-app
# CV_APP_DATA_DIR=~/.local/share/cv-app

# Port panelu (panel zawsze nasłuchuje tylko na 127.0.0.1)
# CV_APP_PORT=8765

# Zdjęcie do CV; domyślnie zdjecie.jpg / zdjecie.png w folderze profilu
# CV_APP_PHOTO_PATH=~/Projects/cv-design-automate/profil/zdjecie.jpg

# Własny Chromium dla PDF (zwykle niepotrzebne po `uv run playwright install chromium`)
# CV_APP_CHROMIUM_EXECUTABLE=/usr/bin/chromium

# Claude Code (`claude -p`): komenda, model, limit czasu w sekundach i liczba ponowień
# CV_APP_CLAUDE_COMMAND=claude
# CV_APP_CLAUDE_MODEL=sonnet
# CV_APP_CLAUDE_TIMEOUT=300
# CV_APP_CLAUDE_RETRIES=2

# Walidator CV: maks. liczba poprawek przez AI (reguły profilu, mieszczenie na stronie)
# CV_APP_CV_FIX_ATTEMPTS=3

# Filtr trafności: słowa w tytule oferty, które ją odrzucają (lista w JSON)
# CV_APP_RELEVANCE_EXCLUDE_KEYWORDS=["senior","lead","manager","kierownik"]

# Strony ofert: odstęp między pobraniami (s), ważność cache (dni), limit czasu (s)
# CV_APP_OFFER_FETCH_DELAY=2
# CV_APP_OFFER_CACHE_DAYS=14
# CV_APP_OFFER_FETCH_TIMEOUT=20
